{
  "name": "galta",
  "private": true,
  "version": "0.1.3",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b && tsc -p native/tsconfig.json && tsc -p scripts/tsconfig.json",
    "build": "bun run typecheck && bun run --cwd apps/extension build",
    "build:dev": "bun run --cwd apps/extension build:dev",
    "dev:watch": "bun run --cwd apps/extension build:dev --watch",
    "bridge:build": "bun build native/adapters/codex/host.ts --compile --outfile native/adapters/codex/galta-codex-bridge && bun build native/bridge/host.ts --compile --outfile native/bridge/galta-canvas-bridge && bun build native/mcp/main.ts --compile --outfile native/mcp/galta-mcp",
    "canvas:install": "bun native/bridge/install.ts",
    "mcp": "bun native/mcp/main.ts",
    "bridge:install": "bun native/adapters/codex/install.ts",
    "companion:preview": "bun scripts/preview-companion.ts",
    "companion:verify": "bun scripts/verify-companion.ts",
    "companion:build": "bun build native/companion/main.ts --compile --outfile native/companion/galta-runtime",
    "package:verify": "bun scripts/verify-package.ts",
    "package:verify-upgrade": "bun scripts/verify-package-upgrade.ts",
    "evaluate:agent": "bun scripts/evaluate-agent.ts",
    "test": "bun run typecheck && bun test tests/*.test.mjs",
    "test:browser": "bun run build && playwright test --grep-invert @serial && playwright test --grep @serial --workers 1",
    "package:mac": "bun scripts/package-macos.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "happy-dom": "^20.14.5",
    "typescript": "5.6.3",
    "zod": "^4.6.5"
  },
  "patchedDependencies": {
    "@excalidraw/excalidraw@0.18.1": "patches/@excalidraw%2Fexcalidraw@0.18.1.patch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@xmldom/xmldom": "^0.9.12",
    "image-size": "^2.0.4"
  },
  "license": "AGPL-3.0-only"
}
