{
  "name": "@galta/extension",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build:dev": "NODE_ENV=production vite build --mode development --config vite.config.ts",
