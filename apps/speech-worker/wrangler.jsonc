{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galta-speech",
  "main": "src/entry.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "speech.galta.art", "custom_domain": true }],
  "ai": { "binding": "AI" },
  "services": [{ "binding": "ACCOUNT", "service": "aha-labs-account" }],
  "durable_objects": { "bindings": [{ "name": "SPEECH_BUDGET", "class_name": "SpeechBudget" }] },
  "migrations": [{ "tag": "speech-budget-v1", "new_sqlite_classes": ["SpeechBudget"] }],
  "vars": { "ENABLED": "true" },
  "ratelimits": [{ "name": "SPEECH_LIMIT", "namespace_id": "1731912", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },
  "env": {
    "staging": {
      "name": "galta-speech-staging",
      "workers_dev": true,
      "routes": [],
      "ai": { "binding": "AI" },
      "services": [{ "binding": "ACCOUNT", "service": "aha-labs-account" }],
      "durable_objects": { "bindings": [{ "name": "SPEECH_BUDGET", "class_name": "SpeechBudget" }] },
      "vars": { "ENABLED": "false" },
      "ratelimits": [{ "name": "SPEECH_LIMIT", "namespace_id": "1731913", "simple": { "limit": 60, "period": 60 } }]
    }
  }
}
